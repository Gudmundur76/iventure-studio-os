	"init_from": "scratch",
	"seed": 42,
	"gradient_accumulation_steps": 4,
	"batch_size": 8,
	"max_iters": 20000,
	"eval_interval": 1000,
	"log_interval": 100,
	"eval_iters": 100,
	"decay_lr": true,
	"lr_decay_iters": 20000,
	"learning_rate": 5e-4,
	"cooldown_frac": 0.2,
	"warmup_iters": 1000,
	"min_lr": 5e-5
}
