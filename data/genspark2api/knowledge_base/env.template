# ==============================================================
# iVenture Studio — Full Stack .env Template
# Phase 27 | All services: LiteLLM + genspark2api + Skywork +
#            OpenManus + VIC Engine + VMOA + Frontend
# ==============================================================
# INSTRUCTIONS:
#   cp .env.template .env
#   Fill in all <REQUIRED> values before running docker compose
#   Optional values have defaults — override as needed
# ==============================================================

# ─────────────────────────────────────────────
# SECTION 1: CORE INFRASTRUCTURE
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_PASSWORD=<REQUIRED: strong_password_here>
POSTGRES_USER=iventure
POSTGRES_DB=iventure_studio

# Redis
REDIS_PASSWORD=<REQUIRED: strong_redis_password>

# LiteLLM master key (used by VIC Engine + frontend)
LITELLM_MASTER_KEY=<REQUIRED: sk-iventure-master-key>

# JWT secret for auth
JWT_SECRET=<REQUIRED: 64_char_random_string>

# MinIO object storage (for agent files + memory blobs)
MINIO_ROOT_USER=iventure
MINIO_ROOT_PASSWORD=<REQUIRED: strong_minio_password>
MINIO_BUCKET=iventure-assets

# ─────────────────────────────────────────────
# SECTION 2: GENSPARK2API GATEWAY
# ─────────────────────────────────────────────
# Get your Genspark session cookie:
# 1. Open genspark.ai in browser
# 2. F12 → Application → Cookies → copy full "session" cookie value

GS_COOKIE=<REQUIRED: your_genspark_session_cookie>
GENSPARK2API_SECRET=<REQUIRED: set_any_secret_key_here>

# Exposes 30+ models: GPT-5, Claude-opus-4, Gemini-2.5-Pro,
# DeepSeek-V3/R1, Grok-4, o3-pro, Sora-2, VEO3, DALL-E-4...
# Models refresh automatically when you update the cookie.

# ─────────────────────────────────────────────
# SECTION 3: DIRECT MODEL API KEYS
# (Used as fallback when genspark2api is unavailable)
# ─────────────────────────────────────────────

# OpenAI (GPT-5, o3, DALL-E)
OPENAI_API_KEY=<OPTIONAL: sk-...>

# Anthropic (Claude-opus-4, Claude-3.5-Sonnet)
ANTHROPIC_API_KEY=<OPTIONAL: sk-ant-...>

# Google AI (Gemini-2.5-Pro, Gemini-Flash)
GOOGLE_AI_API_KEY=<OPTIONAL: AIza...>
GOOGLE_GENERATIVE_AI_API_KEY=<OPTIONAL: AIza...>

# xAI (Grok-4)
XAI_API_KEY=<OPTIONAL: xai-...>

# DeepSeek (V3, R1 — direct China API)
DEEPSEEK_API_KEY=<OPTIONAL: sk-...>

# Groq (fast inference fallback)
GROQ_API_KEY=<OPTIONAL: gsk_...>

# Together AI (open-weight model fallback)
TOGETHER_API_KEY=<OPTIONAL: ...>

# ─────────────────────────────────────────────
# SECTION 4: SKYWORK AI STACK
# ─────────────────────────────────────────────

# Skywork API (R1V4, Super-Agents MCP, DeepResearch)
SKYWORK_API_KEY=<REQUIRED: apply at skyworkmodel.ai>
SKYWORK_API_BASE=https://api.skyworkmodel.ai

# DeepResearch V2 API (request access: deepresearch@skywork.ai)
SKYWORK_DEEPRESEARCH_API_KEY=<OPTIONAL: provided after approval>

# Reward-V2 local deployment
# Model downloaded from HuggingFace — requires token for gated models
HF_TOKEN=<REQUIRED: hf_...>
REWARD_MODEL_ID=Skywork/Skywork-Reward-V2-Qwen3-8B
REWARD_SERVER_PORT=8000

# PRM (Process Reward Model) — step-level verification
PRM_MODEL_PATH=/models/skywork-o1-prm
PRM_SERVER_PORT=8001
PRM_TENSOR_PARALLEL_SIZE=2

# OR1 (math/code reasoning) — local vLLM deployment
OR1_MODEL_ID=Skywork/Skywork-OR1-32B
OR1_SERVER_PORT=8002
OR1_GPU_MEMORY_UTIL=0.90
OR1_MAX_SEQ_LEN=8192

# ─────────────────────────────────────────────
# SECTION 5: OPENMANUS + RL TRAINING
# ─────────────────────────────────────────────

# OpenManus main agent
OPENMANUS_LLM_MODEL=gpt-4o
OPENMANUS_BASE_URL=http://litellm:4000/v1
OPENMANUS_API_KEY=${LITELLM_MASTER_KEY}

# OpenManus-RL training (GRPO fine-tuning)
# Uses verl framework — requires separate GPU allocation
OPENMANUS_RL_ENABLED=true
OPENMANUS_RL_BASE_MODEL=Qwen/Qwen2.5-7B-Instruct
OPENMANUS_RL_REWARD_ENDPOINT=http://reward-server:8000/classify
OPENMANUS_RL_PRM_ENDPOINT=http://prm-server:8001/score
OPENMANUS_RL_TRAINING_BATCH_SIZE=16
OPENMANUS_RL_GRPO_EPOCHS=3
OPENMANUS_RL_OUTPUT_PATH=/models/vic-agent-tuned

# ─────────────────────────────────────────────
# SECTION 6: VIC ENGINE v5
# ─────────────────────────────────────────────

VIC_ENGINE_PORT=8010
VIC_ENGINE_SECRET=<REQUIRED: vic-engine-secret>
VIC_LITELLM_BASE=http://litellm:4000/v1
VIC_LITELLM_KEY=${LITELLM_MASTER_KEY}
VIC_DEFAULT_MODEL=gpt-5
VIC_FALLBACK_MODEL=claude-opus-4
VIC_CHINA_MODEL=deepseek-v3

# GRPO calibration (current production values — do not change without testing)
VIC_GRPO_CALIBRATION=0.991337
VIC_GRPO_ACCURACY=0.92
VIC_GRPO_ADVERSARY_CHALLENGES=481
VIC_GRPO_TARGET=0.997

# Reward endpoint (Skywork-Reward-V2)
VIC_REWARD_ENDPOINT=http://reward-server:8000/classify
VIC_PRM_ENDPOINT=http://prm-server:8001/score

# Memory system
VIC_MEMORY_PATH=/memory/MEMORY.md
VIC_MEMORY_MAX_TOKENS=200000

# Skills library
VIC_SKILLS_PATH=/skills
VIC_SKILLS_COUNT=18

# ─────────────────────────────────────────────
# SECTION 7: VMOA ORCHESTRATOR (8+1 agents)
# ─────────────────────────────────────────────

VMOA_PORT=8011
VMOA_SECRET=<REQUIRED: vmoa-orchestrator-secret>
VMOA_LITELLM_BASE=http://litellm:4000/v1
VMOA_LITELLM_KEY=${LITELLM_MASTER_KEY}

# Agent-specific model assignments
VMOA_AGENT_STRATEGIST_MODEL=gpt-5
VMOA_AGENT_FINANCIAL_MODEL=deepseek-r1
VMOA_AGENT_MARKETING_MODEL=claude-opus-4
VMOA_AGENT_LEGAL_MODEL=claude-opus-4
VMOA_AGENT_TECHNICAL_MODEL=gemini-2.5-pro
VMOA_AGENT_OPERATIONS_MODEL=gpt-5
VMOA_AGENT_RESEARCH_MODEL=skywork-deepresearch-v2
VMOA_AGENT_COMMUNICATION_MODEL=gpt-5
VMOA_AGENT_VISION_MODEL=skywork-r1v4-lite

# ─────────────────────────────────────────────
# SECTION 8: FRONTEND (IntelliAgent Pro Dashboard)
# ─────────────────────────────────────────────

# Next.js public env vars (exposed to browser)
NEXT_PUBLIC_APP_NAME=iVenture Studio
NEXT_PUBLIC_APP_VERSION=1.0.0-phase27
NEXT_PUBLIC_API_BASE=http://api.localhost
NEXT_PUBLIC_LITELLM_BASE=http://litellm.localhost
NEXT_PUBLIC_WS_BASE=ws://api.localhost

# Auth (NextAuth.js)
NEXTAUTH_SECRET=<REQUIRED: 32_char_random_string>
NEXTAUTH_URL=http://studio.localhost

# Google OAuth (for Google Workspace integration)
GOOGLE_CLIENT_ID=<OPTIONAL: from console.cloud.google.com>
GOOGLE_CLIENT_SECRET=<OPTIONAL: from console.cloud.google.com>

# ─────────────────────────────────────────────
# SECTION 9: COMPOSIO (Google Workspace tools)
# ─────────────────────────────────────────────

COMPOSIO_API_KEY=<REQUIRED: from app.composio.dev>
# Connected apps: GOOGLESHEETS, GOOGLEDOCS, GOOGLEDRIVE, GMAIL, GOOGLECALENDAR

# ─────────────────────────────────────────────
# SECTION 10: SKYWORK SUPER-AGENTS MCP
# ─────────────────────────────────────────────

# Used for: PPT, Word docs, Spreadsheets, Webpages generation
# MCP config in mcp_config.json references this key
# Same key as SKYWORK_API_KEY above
OFFICE_TOOL_API_KEY=${SKYWORK_API_KEY}

# ─────────────────────────────────────────────
# SECTION 11: DEPLOYMENT & NETWORKING
# ─────────────────────────────────────────────

# Domain (production)
DOMAIN=iventure.studio
ACME_EMAIL=<REQUIRED: your@email.com>

# atNorth Iceland compute node IP
ATHNORTH_NODE_IP=<REQUIRED: your_compute_node_ip>

# Tesslate Studio deployment
TESSLATE_API_KEY=<OPTIONAL: from tesslate.ai>
TESSLATE_ORG=iventure-studio

# ─────────────────────────────────────────────
# SECTION 12: MONITORING & OBSERVABILITY
# ─────────────────────────────────────────────

# Grafana
GRAFANA_PASSWORD=<REQUIRED: strong_grafana_password>

# Sentry error tracking (optional)
SENTRY_DSN=<OPTIONAL: https://...@sentry.io/...>

# PostHog analytics (optional — for founder usage insights)
POSTHOG_API_KEY=<OPTIONAL: phc_...>
NEXT_PUBLIC_POSTHOG_KEY=<OPTIONAL: phc_...>
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─────────────────────────────────────────────
# SECTION 13: ICELAND BUSINESS (Registration)
# ─────────────────────────────────────────────

# Company details (for automated business doc generation)
COMPANY_NAME=iVenture Studio ehf.
COMPANY_KENNITALA=<REQUIRED: after registration>
COMPANY_ADDRESS=Vestmannaeyjabær, Iceland
COMPANY_EMAIL=<REQUIRED: hello@iventure.studio>
COMPANY_PHONE=<REQUIRED: +354...>

# Shenzhen Longgang subsidy application ref
LONGGANG_SUBSIDY_REF=<OPTIONAL: after application>
LONGGANG_DEADLINE=2026-04-06

# ─────────────────────────────────────────────
# QUICK-START VERIFICATION
# Run after filling all REQUIRED values:
#
#   docker compose up -d traefik postgres redis litellm genspark2api
#   curl http://litellm.localhost/health          # → {"status":"healthy"}
#   curl http://models.localhost/v1/models        # → model list
#   open http://studio.localhost                  # → dashboard
# ─────────────────────────────────────────────
