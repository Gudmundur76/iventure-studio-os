# iVenture MCP Bridge — Environment Variables
# Copy to .env — NEVER commit .env to git

# Auth token Skywork uses to connect (generate a strong random token)
SKYWORK_MCP_TOKEN=mcp_sk_iventure_live_GENERATE_STRONG_TOKEN_HERE

# Genspark session cookie / API key for AI Drive access
GENSPARK2API_SESSION=your_genspark_session_here

# Genspark API base (do not change)
GENSPARK_API_BASE=https://www.genspark.ai/api

# VIC Engine API
VIC_API_BASE=https://api.iventure.studio/v5
VIC_API_KEY=your_vic_api_key_here

PORT=8080
